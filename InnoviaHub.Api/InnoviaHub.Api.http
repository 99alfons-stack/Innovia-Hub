@BASE_URL = http://localhost:5193

### =========================================================
### ADMIN
### =========================================================

@ADMIN_EMAIL = Admin@innoviahub.se
@ADMIN_PASSWORD = Admin1234!

### LOGIN - Login as ADMIN
POST {{BASE_URL}}/api/Auth/login
Content-Type: application/json

{
  "email": "{{ADMIN_EMAIL}}",
  "password": "{{ADMIN_PASSWORD}}"
}


### =========================================================
### USER
### =========================================================

@EMAIL = test@innoviahub.se
@PASSWORD = Test1234!
@FIRST_NAME = Test
@LAST_NAME = User

### CREATE - Create user
POST {{BASE_URL}}/api/Users
Content-Type: application/json

{
  "email": "{{EMAIL}}",
  "password": "{{PASSWORD}}",
  "firstName": "{{FIRST_NAME}}",
  "lastName": "{{LAST_NAME}}"
}

### USERS - Get all users
GET {{BASE_URL}}/api/Users


### =========================================================
### RESOURCE TYPE
### =========================================================

@RESOURCE_TYPE_NAME = VR-Headset
@RESOURCE_TYPE_DESCRIPTION = VR-headset för virtuella upplevelser och interaktiva projekt.

### CREATE - Create resource type
POST {{BASE_URL}}/api/ResourceTypes
Content-Type: application/json

{
  "name": "{{RESOURCE_TYPE_NAME}}",
  "description": "{{RESOURCE_TYPE_DESCRIPTION}}"
}

### RESOURCE TYPES - Get all resource types
GET {{BASE_URL}}/api/ResourceTypes


### =========================================================
### RESOURCE
### =========================================================

@RESOURCE_TYPE_ID = RESOURCE_TYPE_ID - Kopiera in resource type Id
@RESOURCE_NAME = VR-Headset 1
@CAPACITY = 1

### CREATE - Create resource
POST {{BASE_URL}}/api/Resource
Content-Type: application/json

{
  "resourceTypeId": "{{RESOURCE_TYPE_ID}}",
  "name": "{{RESOURCE_NAME}}",
  "capacity": {{CAPACITY}}
}

### RESOURCES - Get all resources
GET {{BASE_URL}}/api/Resource

###
@RESOURCE_ID = RESOURCE_ID - Kopiera in resource Id

### =========================================================
### LOGOUT ADMIN
### =========================================================

### LOGOUT - Logout ADMIN
POST {{BASE_URL}}/api/Auth/logout


### =========================================================
### LOGIN AS MEMBER
### =========================================================

### LOGIN - Login as MEMBER
POST {{BASE_URL}}/api/Auth/login
Content-Type: application/json

{
  "email": "{{EMAIL}}",
  "password": "{{PASSWORD}}"
}


### =========================================================
### BOOKINGS
### =========================================================

@START_TIME = 2026-09-08T10:00:00Z
@END_TIME = 2026-09-08T11:00:00Z

### CREATE - Create booking
POST {{BASE_URL}}/api/Bookings
Content-Type: application/json

{
  "resourceId": "{{RESOURCE_ID}}",
  "startTime": "{{START_TIME}}",
  "endTime": "{{END_TIME}}"
}

### BOOKINGS - Get all bookings
GET {{BASE_URL}}/api/Bookings

###
@BOOKING_ID = BOOKING_ID - Kopiera in booking id

### BOOKING - Get booking by id
GET {{BASE_URL}}/api/Bookings/{{BOOKING_ID}}

### UPDATE - Update booking
PUT {{BASE_URL}}/api/Bookings/{{BOOKING_ID}}
Content-Type: application/json

{
  "resourceId": "{{RESOURCE_ID}}",
  "startTime": "2026-09-08T11:00:00Z",
  "endTime": "2026-09-08T12:00:00Z"
}

### CANCEL - Cancel booking
PATCH {{BASE_URL}}/api/Bookings/{{BOOKING_ID}}/cancel

### BOOKING - Get cancelled booking
GET {{BASE_URL}}/api/Bookings/{{BOOKING_ID}}